<?xml version="1.0"?>
<sdf version="1.9">
  <model name="pgi_staging_cup">
    <!-- Stage-5-only dynamic model.  The Stage-4 static model remains in
         models/pgi_staging_cup/model.sdf and is not changed by this file. -->
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="cup_link">
      <!-- 0.15 kg is the saved project cup mass.  The 0.129 m COM is the
           volume centroid of the measured 50-to-120 mm solid-frustum
           envelope; the inertia remains the documented conservative
           cylinder approximation until measured cup/water data is supplied. -->
      <inertial>
        <pose>0 0 0.129 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00061906</ixx>
          <iyy>0.00061906</iyy>
          <izz>0.00018750</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <velocity_decay><linear>0.01</linear><angular>0.01</angular></velocity_decay>

      <!-- Each band retains the conservative upper-edge radius.  Friction
           1.2 is a provisional rubber/plastic test value, not manufacturer
           data.  Contact stiffness/damping are numerical simulation values. -->
      <collision name="cup_band_1_collision"><pose>0 0 0.0128125 0 0 0</pose><geometry><cylinder><radius>0.029375</radius><length>0.025625</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.02</max_vel><min_depth>0.0002</min_depth></ode></contact></surface></collision>
      <collision name="cup_band_2_collision"><pose>0 0 0.0384375 0 0 0</pose><geometry><cylinder><radius>0.033750</radius><length>0.025625</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.02</max_vel><min_depth>0.0002</min_depth></ode></contact></surface></collision>
      <collision name="cup_band_3_collision"><pose>0 0 0.0640625 0 0 0</pose><geometry><cylinder><radius>0.038125</radius><length>0.025625</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.02</max_vel><min_depth>0.0002</min_depth></ode></contact></surface></collision>
      <collision name="cup_band_4_collision"><pose>0 0 0.0896875 0 0 0</pose><geometry><cylinder><radius>0.042500</radius><length>0.025625</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.02</max_vel><min_depth>0.0002</min_depth></ode></contact></surface></collision>
      <collision name="cup_band_5_collision"><pose>0 0 0.1153125 0 0 0</pose><geometry><cylinder><radius>0.046875</radius><length>0.025625</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.02</max_vel><min_depth>0.0002</min_depth></ode></contact></surface></collision>
      <collision name="cup_band_6_collision"><pose>0 0 0.1409375 0 0 0</pose><geometry><cylinder><radius>0.051250</radius><length>0.025625</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.02</max_vel><min_depth>0.0002</min_depth></ode></contact></surface></collision>
      <collision name="cup_band_7_collision"><pose>0 0 0.1665625 0 0 0</pose><geometry><cylinder><radius>0.055625</radius><length>0.025625</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.02</max_vel><min_depth>0.0002</min_depth></ode></contact></surface></collision>
      <collision name="cup_band_8_collision"><pose>0 0 0.1921875 0 0 0</pose><geometry><cylinder><radius>0.060000</radius><length>0.025625</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.02</max_vel><min_depth>0.0002</min_depth></ode></contact></surface></collision>

      <visual name="cup_band_1_visual"><pose>0 0 0.0128125 0 0 0</pose><geometry><cylinder><radius>0.029375</radius><length>0.025625</length></cylinder></geometry><material><ambient>0.05 0.35 0.85 1</ambient><diffuse>0.05 0.35 0.85 1</diffuse></material></visual>
      <visual name="cup_band_2_visual"><pose>0 0 0.0384375 0 0 0</pose><geometry><cylinder><radius>0.033750</radius><length>0.025625</length></cylinder></geometry><material><ambient>0.05 0.35 0.85 1</ambient><diffuse>0.05 0.35 0.85 1</diffuse></material></visual>
      <visual name="cup_band_3_visual"><pose>0 0 0.0640625 0 0 0</pose><geometry><cylinder><radius>0.038125</radius><length>0.025625</length></cylinder></geometry><material><ambient>0.05 0.35 0.85 1</ambient><diffuse>0.05 0.35 0.85 1</diffuse></material></visual>
      <visual name="cup_band_4_visual"><pose>0 0 0.0896875 0 0 0</pose><geometry><cylinder><radius>0.042500</radius><length>0.025625</length></cylinder></geometry><material><ambient>0.05 0.35 0.85 1</ambient><diffuse>0.05 0.35 0.85 1</diffuse></material></visual>
      <visual name="cup_band_5_visual"><pose>0 0 0.1153125 0 0 0</pose><geometry><cylinder><radius>0.046875</radius><length>0.025625</length></cylinder></geometry><material><ambient>0.05 0.35 0.85 1</ambient><diffuse>0.05 0.35 0.85 1</diffuse></material></visual>
      <visual name="cup_band_6_visual"><pose>0 0 0.1409375 0 0 0</pose><geometry><cylinder><radius>0.051250</radius><length>0.025625</length></cylinder></geometry><material><ambient>0.05 0.35 0.85 1</ambient><diffuse>0.05 0.35 0.85 1</diffuse></material></visual>
      <visual name="cup_band_7_visual"><pose>0 0 0.1665625 0 0 0</pose><geometry><cylinder><radius>0.055625</radius><length>0.025625</length></cylinder></geometry><material><ambient>0.05 0.35 0.85 1</ambient><diffuse>0.05 0.35 0.85 1</diffuse></material></visual>
      <visual name="cup_band_8_visual"><pose>0 0 0.1921875 0 0 0</pose><geometry><cylinder><radius>0.060000</radius><length>0.025625</length></cylinder></geometry><material><ambient>0.05 0.35 0.85 1</ambient><diffuse>0.05 0.35 0.85 1</diffuse></material></visual>

      <collision name="center_straw_collision"><pose>0 0 0.240 0 0 0</pose><geometry><cylinder><radius>0.004</radius><length>0.070</length></cylinder></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>
      <visual name="center_straw_visual"><pose>0 0 0.240 0 0 0</pose><geometry><cylinder><radius>0.004</radius><length>0.070</length></cylinder></geometry><material><ambient>0.95 0.95 0.90 1</ambient><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
    </link>
    <frame name="grasp_band" attached_to="cup_link"><pose>0 0 0.040 0 0 0</pose></frame>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>60</update_frequency>
    </plugin>
  </model>
</sdf>
